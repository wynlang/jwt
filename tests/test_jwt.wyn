// Exercises the shipped lib in src/jwt.wyn via the tests/jwt.wyn symlink.
// NOTE: this package uses a non-standard signature encoding
// (base64url(hex(hmac)) rather than RFC-7519 base64url(raw-bytes)),
// so these vectors are self-consistent but not RFC-interoperable.
import jwt

test "base64url round-trip" {
    var enc = jwt.base64url_encode("{\"sub\":\"u1\"}")
    assert_eq(jwt.base64url_decode(enc), "{\"sub\":\"u1\"}")
}
test "base64url has no padding or +/" {
    var enc = jwt.base64url_encode("????>>>>")
    assert(not enc.contains("="))
    assert(not enc.contains("+"))
    assert(not enc.contains("/"))
}
test "encode produces standard header" {
    var tok = jwt.Jwt_encode("{\"sub\":\"u1\"}", "secret")
    assert(tok.starts_with("eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9."))
}
test "encode has three parts" {
    var tok = jwt.Jwt_encode("{\"sub\":\"u1\"}", "secret")
    assert_eq(tok.split(".").len(), 3)
}
test "decode recovers payload" {
    var tok = jwt.Jwt_encode("{\"sub\":\"u1\"}", "secret")
    assert_eq(jwt.Jwt_decode(tok), "{\"sub\":\"u1\"}")
}
test "verify good signature" {
    var tok = jwt.Jwt_encode("{\"sub\":\"u1\"}", "secret")
    assert_eq(jwt.Jwt_verify(tok, "secret"), 1)
}
test "verify wrong secret" {
    var tok = jwt.Jwt_encode("{\"sub\":\"u1\"}", "secret")
    assert_eq(jwt.Jwt_verify(tok, "wrong"), 0)
}
test "verify tampered payload" {
    var tok = jwt.Jwt_encode("{\"sub\":\"u1\"}", "secret")
    var parts = tok.split(".")
    var forged = parts[0] + "." + jwt.base64url_encode("{\"sub\":\"admin\"}") + "." + parts[2]
    assert_eq(jwt.Jwt_verify(forged, "secret"), 0)
}
test "verify malformed" {
    assert_eq(jwt.Jwt_verify("not.a.jwt.token", "secret"), 0)
    assert_eq(jwt.Jwt_verify("onlyonepart", "secret"), 0)
}
